{
  "id": "/mobile",
  "name": "Kiln — Agentic delivery",
  "short_name": "Kiln",
  "description": "Twelve FDE-led AI workstreams, isolated sandboxes, real exports and a human at every gate.",
  "start_url": "/mobile",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "portrait-primary",
  "background_color": "#f6f2e9",
  "theme_color": "#101820",
  "categories": ["business", "productivity"],
  "icons": [
    {
      "src": "/assets/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/assets/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/assets/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Open chat",
      "short_name": "Chat",
      "url": "/mobile?view=chat",
      "icons": [{ "src": "/assets/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Workstreams",
      "short_name": "Workstreams",
      "url": "/mobile?view=workstreams",
      "icons": [{ "src": "/assets/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Sandbox",
      "short_name": "Sandbox",
      "url": "/mobile?view=sandbox",
      "icons": [{ "src": "/assets/icon-192.png", "sizes": "192x192" }]
    }
  ]
}
